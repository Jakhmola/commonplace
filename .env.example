OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Read by docker compose to initialise Postgres. Keep DATABASE_URL in sync.
POSTGRES_USER=commonplace
POSTGRES_PASSWORD=commonplace
POSTGRES_DB=commonplace
DATABASE_URL=postgresql+asyncpg://commonplace:commonplace@localhost:5433/commonplace

# 1 = local Inngest dev server container. 0 = Inngest Cloud: set both keys, and
# `make up` then leaves the dev server out. The app must be reachable from Inngest
# Cloud at /api/inngest (see infra/docker-compose.prod.yml).
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# When set, every route except /health and /api/inngest requires
# "Authorization: Bearer <token>". Required by the production compose file.
API_TOKEN=

APP_PORT=8000
USER_AGENT=commonplace/0.1

# Flow control on ingest-article. Articles of one publication in flight at once,
# and run starts per minute across all publications (about one embedding request
# each). To watch a manual article overtake a backfill, try 1 and 10.
CONCURRENCY_PER_PUBLICATION=3
INGEST_RUNS_PER_MINUTE=50

# Model used by POST /ask.
SYNTHESIS_MODEL=claude-opus-5-5

# Claim extraction. One model call per article; a 60-article corpus cost about $3.50
# with this model. A cheaper one (claude-sonnet-5-5, claude-haiku-5-5) can be set here.
EXTRACTION_MODEL=claude-opus-5-5

# The claim graph. Memgraph Lab is on http://localhost:3000
MEMGRAPH_URI=bolt://localhost:7687

# Evaluation. Two judge calls per answer at most. A judge from a different model
# family than SYNTHESIS_MODEL is less likely to be lenient towards its own output.
EVAL_JUDGE_MODEL=claude-opus-5-5
EVAL_MIN_TPR=0.90
EVAL_MIN_TNR=0.90

# Research agent. Three bounds on one run: rounds of searching, dollars spent on
# planning and reflection, and convergence (a round that finds nothing new ends it).
RESEARCH_MODEL=claude-opus-5-5
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_USD=0.75

# Weekly digest: when it runs (cron, UTC) and how many complete days it covers.
DIGEST_CRON=0 8 * * 1
DIGEST_LOOKBACK_DAYS=7
